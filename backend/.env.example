# Copy this to .env and fill in your values

# Secret for signing JWT tokens (make this long and random)
JWT_SECRET=change_this_to_a_long_random_string

# API key the Python bot uses to authenticate with the backend
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BOT_API_KEY=change_this_to_a_long_random_string

# Port for backend server
PORT=3001

# --- Roblox bio verification (noblox.js) ---
# The bot account's .ROBLOSECURITY cookie (only needed for bio verification)
BOT_COOKIE=your_.ROBLOSECURITY_cookie_here
