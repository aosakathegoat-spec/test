# Copy this to .env and fill in your values

# Bot Roblox account .ROBLOSECURITY cookie
# Get this by logging into roblox.com, opening DevTools > Application > Cookies
BOT_COOKIE=your_.ROBLOSECURITY_cookie_here

# Your bot account's Roblox user ID (numbers in profile URL)
BOT_USER_ID=12345678

# Secret for signing JWT tokens (make this long and random)
JWT_SECRET=change_this_to_a_long_random_string

# Port for backend server
PORT=3001
